{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "cellar",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev"],
			"port": 5173
		},
		{
			"name": "cellar-scratch",
			"runtimeExecutable": "bash",
			"runtimeArgs": ["-c", ". \"$HOME/.nvm/nvm.sh\" && npm run dev:scratch"],
			"port": 5175
		},
		{
			"name": "cellar-scratch-5176",
			"runtimeExecutable": "bash",
			"runtimeArgs": [
				"-c",
				". \"$HOME/.nvm/nvm.sh\" && CELLAR_DATA_DIR=.scratch/data CELLAR_PHOTOS_DIR=.scratch/photos npx vite dev --host --port 5176 --strictPort"
			],
			"port": 5176
		},
		{
			"name": "cellar-scratch-empty",
			"runtimeExecutable": "bash",
			"runtimeArgs": [
				"-c",
				". \"$HOME/.nvm/nvm.sh\" && CELLAR_DATA_DIR=.scratch/empty/data CELLAR_PHOTOS_DIR=.scratch/empty/photos npx vite dev --host --port 5177 --strictPort"
			],
			"port": 5177
		}
	]
